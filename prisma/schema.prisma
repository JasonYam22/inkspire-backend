generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String       @id @default(uuid())
  email                   String       @unique
  password                String
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  username                String
  imageUrl                String?
  role                    Role         @default(USER)
  isEmailVerified         Boolean      @default(false)
  verificationToken       String?      @unique
  verificationTokenExpiry DateTime?
  resetPasswordExpiry     DateTime?
  resetPasswordToken      String?      @unique
  comments                Comment[]    @relation("UserComments")
  ideas                   TattooIdea[]
  savedIdeas              TattooIdea[] @relation("SavedIdeas")
}

model TattooIdea {
  id         String    @id @default(uuid())
  title      String
  genre      String?
  spot       String?
  imageUrl   String?
  notes      String?
  isFavorite Boolean   @default(false)
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  artist     String?
  social     String?
  isPublic   Boolean   @default(false)
  comments   Comment[] @relation("IdeaComments")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy    User[]    @relation("SavedIdeas")
}

model Comment {
  id           String     @id @default(uuid())
  content      String
  userId       String
  tattooIdeaId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tattooIdea   TattooIdea @relation("IdeaComments", fields: [tattooIdeaId], references: [id], onDelete: Cascade)
  user         User       @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ARTIST
}
